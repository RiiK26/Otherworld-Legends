:; # Run this script to build the OtherworldLegends.dll and injector.exe
:; set -e
:; cd "$(dirname "$0")/.."
:; echo "Building project with CMake (Linux -> Windows MinGW)..."
:; mkdir -p build
:; cd build
:; cmake .. -Wno-unused-cli -DCMAKE_SYSTEM_NAME=Windows -DCMAKE_C_COMPILER=x86_64-w64-mingw32-gcc -DCMAKE_CXX_COMPILER=x86_64-w64-mingw32-g++ -DCMAKE_RC_COMPILER=x86_64-w64-mingw32-windres -DCMAKE_FIND_ROOT_PATH=/usr/x86_64-w64-mingw32 -DCMAKE_FIND_ROOT_PATH_MODE_PROGRAM=NEVER -DCMAKE_FIND_ROOT_PATH_MODE_LIBRARY=ONLY -DCMAKE_FIND_ROOT_PATH_MODE_INCLUDE=ONLY
:; cmake --build . -j$(nproc)
:; echo "Build complete."
:; exit 0

@echo off
REM Run this script to build the OtherworldLegends.dll and injector.exe on Windows
cd /d "%~dp0.."
echo Building project with CMake (Windows MSVC)...
if not exist build mkdir build
cd build
cmake ..
cmake --build . --config Release -j %NUMBER_OF_PROCESSORS%
echo Build complete.
pause
